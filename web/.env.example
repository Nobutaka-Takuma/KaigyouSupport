# Base URL of the API. Leave empty in development to use the Vite proxy.
VITE_API_BASE=

# Basemap. MapLibre needs raster or vector tiles from somewhere; nothing is
# bundled. Either point at a style JSON:
#   VITE_BASEMAP_STYLE=https://example.com/style.json
# or at an XYZ raster template (respect the provider's usage policy):
#   VITE_RASTER_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   VITE_RASTER_ATTRIBUTION=© OpenStreetMap contributors
# With neither set, the map renders our data layers on a plain background.
VITE_BASEMAP_STYLE=
VITE_RASTER_TILES=
VITE_RASTER_ATTRIBUTION=
