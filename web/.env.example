# Base URL of the API. Leave empty in development to use the Vite proxy.
VITE_API_BASE=

# Basemap. MapLibre needs raster or vector tiles from somewhere; nothing is
# bundled. With neither of these set the map still works -- our layers render
# on a plain background -- but street context is worth having.
#
# The values below are the GSI (国土地理院) 淡色地図: no key, no account, and
# the terms permit this use as long as the credit is displayed, which
# VITE_RASTER_ATTRIBUTION does. Swap in a style JSON instead if you have one:
#   VITE_BASEMAP_STYLE=https://example.com/style.json
#
# These are read at BUILD time, not at run time. Changing them on a hosting
# platform takes effect on the next deploy, not on the next request.
VITE_BASEMAP_STYLE=
VITE_RASTER_TILES=https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png
VITE_RASTER_ATTRIBUTION=国土地理院
